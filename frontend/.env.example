VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# Google sign-in uses this Supabase client; enable the provider and SDU Auth Hook
# in Supabase before releasing. No Google OAuth secret belongs in VITE variables.

# Private Storage bucket configured by the backend team.
VITE_SUPABASE_STORAGE_BUCKET=startup-media

# Optional external event destinations (or set them in the admin event editor).
VITE_EVENT_REGISTRATION_URL=
VITE_DEMO_DAY_ARCHIVE_URL=
